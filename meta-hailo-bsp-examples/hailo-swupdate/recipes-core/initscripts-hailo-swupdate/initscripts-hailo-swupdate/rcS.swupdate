#!/bin/bash

# stop upon error
set -e

PATH=/sbin:/bin:/usr/sbin:/usr/bin

function exit_trap() {
    # sometimes exiting the process results in the last prints from being cut
    # because the system reboots right after the exit. So we add a small sleep
    sleep 3
}

# This function, called after swupdate finished, updates scu_bl_cfg file with boot_image_mode field set to 0
function post_swupdate_modify_scu_bl_cfg_bin()
{ 
    current_copy=$(/etc/get_sw_image.sh --next)

    # handling of boot_image_mode is only relevant to image a
    if [ "${current_copy}" = "a" ]; then
        /etc/set_sw_image.sh a
    fi
}

function run_swupdate() {
    cd /tmp
    echo "Downloading ${SWUPDATE_UPDATE_FILENAME} from ${SWUPDATE_SERVER_IP} via TFTP..."
    tftp -g -r "${SWUPDATE_UPDATE_FILENAME}" "${SWUPDATE_SERVER_IP}"

    for update_mode in ${SWUPDATE_UPDATE_MODES//,/ }
    do
        echo "*******************************************"
        echo
        echo "Running: swupdate with mode ${update_mode}"
        echo
        echo "*******************************************"
        swupdate -i "${SWUPDATE_UPDATE_FILENAME}" -v -m -M -e "stable,${update_mode}"
    done

    # updates scu_bl_cfg file
    post_swupdate_modify_scu_bl_cfg_bin

    echo "SWUpdate finished"

    echo "Rebooting..."
    reboot -f

    return 0
}

function main() {
    umask 022
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -o size=4G -t tmpfs tmpfs /tmp

    ln -s /tmp /var/volatile

    # These parameters come from the kernel command line
    # so we want to make sure that they are not empty
    if [[ -z "${SWUPDATE_SERVER_IP}" || \
          -z "${SWUPDATE_SERVER_UDP_LOGGING_PORT}" || \
          -z "${SWUPDATE_UPDATE_MODES}" || \
          -z "${SWUPDATE_UPDATE_FILENAME}" ]]; then
        echo "Missing kernel command line parameters"
        echo "SWUPDATE_SERVER_IP: ${SWUPDATE_SERVER_IP}"
        echo "SWUPDATE_SERVER_UDP_LOGGING_PORT: ${SWUPDATE_SERVER_UDP_LOGGING_PORT}"
        echo "SWUPDATE_UPDATE_FILENAME: ${SWUPDATE_UPDATE_FILENAME}"
        echo "SWUPDATE_UPDATE_MODES: ${SWUPDATE_UPDATE_MODES}"
        exit 1
    fi

    # optionally allow changing the firmware device. it is always set together with the firmware environment device
    # since for mtd it is different (fw env is mdt0 and fw is mtdblock0)
    if { [ -n "${SWUPDATE_FW_ENV_DEVICE}" ] && [ -z "${SWUPDATE_FIRMWARE_DEVICE}" ]; } || \
        { [ -z "${SWUPDATE_FW_ENV_DEVICE}" ] && [ -n "${SWUPDATE_FIRMWARE_DEVICE}" ]; }; then
         echo "Error: Both SWUPDATE_FW_ENV_DEVICE and SWUPDATE_FIRMWARE_DEVICE must be set together."
         exit 1
    fi

    # List of config variables to check and write to /tmp/swupdate.cfg if set
    CONFIG_VARS=(
        SWUPDATE_FW_ENV_DEVICE
        SWUPDATE_FIRMWARE_DEVICE
        SWUPDATE_BOOTLOADER_DEVICE
        SWUPDATE_FILESYSTEM_DEVICE
        SWUPDATE_ROOTFS_DEVICE
        SWUPDATE_FITIMAGE_DEVICE
    )
    # Handle all other config variables
    for var in "${CONFIG_VARS[@]}"; do
        value="${!var}"
        if [ -n "$value" ]; then
            key="${var#SWUPDATE_}"
            echo "${key}=${value}" >> /tmp/swupdate.cfg
        fi
    done

    if [[ -n "${SWUPDATE_IPADDR}" && "${SWUPDATE_IPADDR}" != "10.0.0.1" ]]; then
         echo "Applying local IP: ${SWUPDATE_IPADDR}"
         ip addr add "${SWUPDATE_IPADDR}/24" dev eth0
    else
         echo "Using default network configuration (IP is either empty or default 10.0.0.1)"
    fi

    /etc/init.d/networking start

    echo "Waiting for networking service is up..."

    # Waiting for networking sericve is up
    sleep 10

    # The goal is to dump SW update output to both stdout and to remote 'nc' listener.
    run_swupdate |& tee /proc/self/fd/2 | nc -u "${SWUPDATE_SERVER_IP}" "${SWUPDATE_SERVER_UDP_LOGGING_PORT}"

    return 0
}

trap exit_trap EXIT

main

exit 0
