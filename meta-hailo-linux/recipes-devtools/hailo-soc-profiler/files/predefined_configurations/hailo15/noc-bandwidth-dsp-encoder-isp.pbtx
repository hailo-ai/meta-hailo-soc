data_sources {
  config {
    name: "linux.perf"
    perf_event_config {
        timebase {
          hailo_noc_event {
          }
          period: 1
        }
        ring_buffer_pages: 1024
        aux_ring_buffer_pages: 8192
        ring_buffer_read_period_ms: 1000
        followers {
          name: "dsp"
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_0
            route_id {
              route_id_base: 0
              route_id_mask: 1835008
            }
          }
        }
        followers {
          name: "Encoder"
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_1
            filter: "h265"
          }
        }
        followers {
          name: "ISP Fast Bus"
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_2
            filter: "isp_fastbus"
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_3
          }
        }
        followers {
          name: "NN Core configuration bandwidth"
          hailo_noc_counter {
            type: HAILO_CSM_COUNTER
          }
        }
        followers {
          name: "NN Core data RX bandwidth"
          hailo_noc_counter {
            type: HAILO_DSM_RX_COUNTER
          }
        }
        followers {
          name: "NN Core data TX bandwidth"
          hailo_noc_counter {
            type: HAILO_DSM_TX_COUNTER
          }
        }
    }
  }
}
