data_sources {
  config {
    name: "linux.perf"
    perf_event_config {
        timebase {
          hailo_noc_event {
          }
          period: 1
        }
        ring_buffer_pages: 1024
        aux_ring_buffer_pages: 8192
        ring_buffer_read_period_ms: 1000
        followers {
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_0
            filter: "ap_cluster_ace"
          }
        }
        followers {
          name: "AP + DDMA + csi_rx0"
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_1
            route_id {
              route_id_base: 262144
              route_id_mask: 1835008
            }
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_2
            filter: "dram_dma_ddrbus_desc"
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_NOC_COUNTER_3
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_CSM_COUNTER
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_DSM_RX_COUNTER
          }
        }
        followers {
          hailo_noc_counter {
            type: HAILO_DSM_TX_COUNTER
          }
        }
    }
  }
}
