data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      # All VB2/V4L2 events
      ftrace_events: "v4l2/vb2_v4l2_buf_done"
      ftrace_events: "v4l2/vb2_v4l2_buf_queue"
      ftrace_events: "v4l2/vb2_v4l2_dqbuf"
      ftrace_events: "v4l2/v4l2/vb2_v4l2_qbuf"
      ftrace_events: "v4l2/vb2_buf_done"
      ftrace_events: "v4l2/vb2_buf_queue"

      # Buffer configuration
      buffer_size_kb: 8192
    }
  }
}